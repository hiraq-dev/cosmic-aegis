# Copy to .env and fill in. Never commit real values.
DATABASE_URL=sqlite:///./aegis.db            # use postgresql+psycopg://user:pass@host:5432/aegis in production
AEGIS_ENV=development                         # production refuses to start without a real JWT secret
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://cosmic-aegis-beryl.vercel.app
NASA_API_KEY=                                 # server side only; DONKI falls back to DEMO_KEY (heavily rate limited)
ANTHROPIC_API_KEY=                            # optional; without it the assistant is retrieval-only
ANTHROPIC_MODEL=claude-haiku-5-5
POLL_NASA=1                                   # set 0 to disable background polling (tests)
